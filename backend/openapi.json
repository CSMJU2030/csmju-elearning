          },
          "slug": {
            "type": "string",
            "description": "ตัวระบุใน URL (a-z 0-9 -) · ไม่ส่งมาระบบสร้างให้"
          },
          "summary": {
            "type": "string",
            "description": "คำอธิบายสั้นบนการ์ด"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
